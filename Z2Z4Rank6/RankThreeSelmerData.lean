/-- Euler's criterion evaluated by finite modular exponentiation. -/
def modSquareTest (p : ℕ) (n : ℤ) : Bool :=
  decide ((n : ZMod p)=0 ∨ (n : ZMod p)^(p/2)=1)

theorem modSquareTest_iff (p : ℕ) [Fact p.Prime] (n : ℤ) :
    modSquareTest p n=true ↔ IsSquare (n : ZMod p) := by
  rw [modSquareTest,decide_eq_true_eq]
  by_cases h : (n : ZMod p)=0
  · simp [h]
  · simp only [h,false_or]
    exact (ZMod.euler_criterion p h).symm

def localTest (d : ECFullTriple) : Bool :=
  ([17,19,41,283] : List ℕ).all (fun p => modSquareTest p d.2.2) &&
  ([11,13,47] : List ℕ).all (fun p => modSquareTest p d.2.1) &&
  ([3,7,73,139] : List ℕ).all
    (fun p => modSquareTest p (if (p : ℤ)∣d.2.1 then -d.1 else d.1))

