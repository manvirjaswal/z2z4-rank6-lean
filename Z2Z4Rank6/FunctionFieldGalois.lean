module

public import Z2Z4Rank6.FunctionFieldAutomorphisms
public import Mathlib.FieldTheory.Galois.Basic

@[expose] public section

/-!
# The biquadratic Galois group of Q(C)/Q(m)

This proves the field-theoretic clause of Remark 4.3 of Manvir Jaswal,
DOI 10.5281/zenodo.23437117, for the constructed degree-four
field. The four automorphisms are the two printed sign changes.
-/

namespace Z2Z4Rank6.FunctionField

noncomputable section

instance finiteDimensional : FiniteDimensional Base K := Module.Finite.of_basis basis

/-- The automorphism with a specified pair of sign changes. -/
def signAut (t : ZMod 2 × ZMod 2) : K ≃ₐ[Base] K :=
  (if t.1=0 then 1 else sigmaU) * (if t.2=0 then 1 else sigmaV)

theorem signAut00 : signAut (0,0) = 1 := by
  unfold signAut
  rw [ite_eq_left rfl, ite_eq_left rfl, one_mul]
theorem signAut10 : signAut (1,0) = sigmaU := by
  unfold signAut
  rw [ite_eq_right (by decide), ite_eq_left rfl, mul_one]
theorem signAut01 : signAut (0,1) = sigmaV := by
  unfold signAut
  rw [ite_eq_left rfl, ite_eq_right (by decide), one_mul]
theorem signAut11 : signAut (1,1) = sigmaU * sigmaV := by
  unfold signAut
  rw [ite_eq_right (by decide), ite_eq_right (by decide)]

/-- The two sign choices define a group homomorphism from the Klein four group. -/
def signHom : Multiplicative (ZMod 2 × ZMod 2) →* (K ≃ₐ[Base] K) where
  toFun t := signAut t.toAdd
  map_one' := by simp [signAut]
  map_mul' g h := by
    rcases g with ⟨a,b⟩
    rcases h with ⟨c,d⟩
    change signAut ((a,b)+(c,d)) = signAut (a,b) * signAut (c,d)
    fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;>
      simp only [show (⟨0,by decide⟩:Fin 2) = (0:ZMod 2) by rfl,
        show (⟨1,by decide⟩:Fin 2) = (1:ZMod 2) by rfl, Prod.mk_add_mk, show (0:ZMod 2)+0=0 by decide,
        show (0:ZMod 2)+1=1 by decide, show (1:ZMod 2)+0=1 by decide,
        show (1:ZMod 2)+1=0 by decide, signAut00, signAut10,signAut01,signAut11] <;>
      apply AlgEquiv.ext <;> intro z <;> simp only [AlgEquiv.mul_apply,
        AlgEquiv.one_apply, sigmaU_involutive, sigmaV_involutive, sigmaU_sigmaV_commute]

/-- Distinct sign choices act differently on the two nonzero roots. -/
theorem signHom_injective : Function.Injective signHom := by
  intro g k h
  rcases g with ⟨a,b⟩
  rcases k with ⟨c,d⟩
  change signAut (a,b)=signAut (c,d) at h
  change (a,b)=(c,d)
  have hnu : -u ≠ u := by
    intro h
    have h2 : (2 : K)*u=0 := by linear_combination -h
    exact u_ne_zero ((mul_eq_zero.mp h2).resolve_left (by norm_num))
  have hnv : -v ≠ v := by
    intro h
    have h2 : (2 : K)*v=0 := by linear_combination -h
    exact v_ne_zero ((mul_eq_zero.mp h2).resolve_left (by norm_num))
  have hu := congrArg (fun f : K ≃ₐ[Base] K => f u) h
  have hv := congrArg (fun f : K ≃ₐ[Base] K => f v) h
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;>
    simp only [show (⟨0,by decide⟩:Fin 2) = (0:ZMod 2) by rfl,
      show (⟨1,by decide⟩:Fin 2) = (1:ZMod 2) by rfl,
      signAut00,signAut10,signAut01,signAut11,AlgEquiv.mul_apply,
      AlgEquiv.one_apply,sigmaU_u,sigmaU_v,sigmaV_u,sigmaV_v,map_neg] at hu hv <;>
    first | rfl | exact False.elim (hnu hu) | exact False.elim (hnu hu.symm) |
      exact False.elim (hnv hv) | exact False.elim (hnv hv.symm)

/-- There are exactly four Q(m)-automorphisms of Q(C). -/
theorem card_automorphisms : Fintype.card (K ≃ₐ[Base] K) = 4 := by
  have hupper := AlgEquiv.card_le (F:=Base) (K:=K)
  have hlower := Fintype.card_le_of_injective signHom signHom_injective
  have hfour : Fintype.card (Multiplicative (ZMod 2 × ZMod 2)) = 4 := by decide
  rw [finrank_eq_four] at hupper
  rw [hfour] at hlower
  exact Nat.le_antisymm hupper hlower

/-- The constructed extension is Galois. -/
instance isGalois : IsGalois Base K := by
  apply IsGalois.of_card_aut_eq_finrank
  rw [Nat.card_eq_fintype_card, card_automorphisms, finrank_eq_four]

/-- The Galois group is the Klein four group generated by the printed
u and v sign changes. -/
def galoisEquivKleinFour : (K ≃ₐ[Base] K) ≃* Multiplicative (ZMod 2 × ZMod 2) :=
  (MulEquiv.ofBijective signHom
    ((Fintype.bijective_iff_injective_and_card signHom).mpr
      ⟨signHom_injective, by rw [card_automorphisms]; decide⟩)).symm

end
end Z2Z4Rank6.FunctionField
