def freeTail (i : Fin 4) : Fin 2 → ZMod 2 :=
  fun j => if i.val.testBit j.val then 1 else 0
def freeChunk (i : Fin 4) : List (Fin 5 → ZMod 2) :=
  (binaryVectors 3).map (fun v => Fin.append v (freeTail i))
