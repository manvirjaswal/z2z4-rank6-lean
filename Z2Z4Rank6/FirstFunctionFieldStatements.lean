module

public import Z2Z4Rank6.Statements
public import Z2Z4Rank6.FunctionFieldSpecialization
public import Z2Z4Rank6.SingularFibers
public import Mathlib.LinearAlgebra.Dimension.Basic
public import Mathlib.GroupTheory.Index
public import Z2Z4Rank6.RankFiniteIndex

@[expose] public section

/-!
# First-family function-field statements

Theorem 1.2(b) and Proposition 5.2 of M. Jaswal,
*Infinitely many elliptic curves with torsion Z/2Z × Z/4Z and rank at least six*,
DOI 10.5281/zenodo.23437117.

The field is the explicit degree-four field generated by the transcendental
parameter m and the two printed square roots. This module records the first
family's function-field rank and finite-index statements. The complete base
geometry is proved in FirstBaseGeometry.
-/

namespace Z2Z4Rank6

/-- The Mordell--Weil group over the constructed function field Q(C). -/
abbrev GenericPoints := (X FunctionField.m).toAffine.Point

/-- Theorem 1.2(b): the six specified points are integer-linearly
independent and the point group over Q(C) has rank exactly six. -/
def Theorem12b : Prop :=
  LinearIndependent ℤ FunctionField.points ∧ Module.rank ℤ GenericPoints = 6

/-- The subgroup generated by exactly the six specified points. -/
noncomputable def genericSixSpan : AddSubgroup GenericPoints :=
  (Submodule.span ℤ (Set.range FunctionField.points)).toAddSubgroup

/-- The finite-index conclusion in Proposition 5.2, using the generated
subgroup of the function-field point group. -/
def GenericSixFiniteIndex : Prop := genericSixSpan.FiniteIndex

/-- The independence half of Theorem 1.2(b), via the formal-local
specialization. The hypotheses are published theorems. -/
theorem theorem12b_independence
    (hMazur : MazurTorsionTheorem)
    (hReduction : GoodReductionHomomorphisms)
    (hFormal : FormalGoodReductionHomomorphisms) :
    LinearIndependent ℤ FunctionField.points :=
  FunctionField.points_independent hMazur hReduction hFormal

/-- The ordinary cardinal-valued rank of the generic point group is
at least six. This records the usual rank consequence of the specified points. -/
theorem generic_rank_at_least_six
    (hMazur : MazurTorsionTheorem)
    (hReduction : GoodReductionHomomorphisms)
    (hFormal : FormalGoodReductionHomomorphisms) :
    6 ≤ Module.rank ℤ GenericPoints := by
  simpa using (theorem12b_independence hMazur hReduction hFormal).cardinal_le_rank

/-- Finite generation, exact rank six and independence imply the finite-index
conclusion of Proposition 5.2 for the six specified points. -/
theorem genericSixFiniteIndex_of_rank_and_finite_generation
    (hMazur : MazurTorsionTheorem)
    (hReduction : GoodReductionHomomorphisms)
    (hFormal : FormalGoodReductionHomomorphisms)
    [Module.Finite ℤ GenericPoints]
    (hrank : Module.rank ℤ GenericPoints = 6) : GenericSixFiniteIndex :=
  finiteIndex_span_of_rank_eq FunctionField.points
    (theorem12b_independence hMazur hReduction hFormal) hrank

/-- The exact sixteen-exception and torsion-inclusion half of Theorem 1.2(c).
The complete cofinite assertion is proved in FirstFamilyCofinite. -/
theorem theorem12c_smooth_and_torsion_contains :
    ∀ c : CPoint, c ∉ exceptionalPoints →
      GoodCurve (X c.m) ∧ TorsionContains (X c.m) :=
  theorem12c_first_clause

end Z2Z4Rank6
