import Z2Z4Rank6.FunctionFieldPointActions
import Mathlib.GroupTheory.Finiteness
import Mathlib.LinearAlgebra.Dimension.Torsion.Finite

/-!
# Finite generation over finitely generated characteristic-zero fields

The final finite-generation step of Proposition 5.2 in Manvir Jaswal,
"Infinitely many elliptic curves with torsion Z/2Z × Z/4Z and rank at least
six", DOI: 10.5281/zenodo.23437117.

The hypothesis is the elliptic-curve, characteristic-zero case of
Brian Conrad, "Chow's K/k-image and K/k-trace, and the Lang–Néron theorem",
L'Enseignement Mathématique (2) 52 (2006), no. 1–2, 37–108,
Corollary 7.2, printed p. 77, DOI: 10.5169/seals-2226. The author's final
manuscript has this statement on p. 23. It is explicitly deduced there from
the Lang–Néron theorem, Theorem 7.1, and number-field Mordell–Weil.

The hypothesis below is generic over all finitely generated fields over Q.
Finite field generation is expressed using intermediate fields,
not finite generation as a Q-algebra.
-/

namespace Z2Z4Rank6

universe u

/-- The elliptic, characteristic-zero case of Conrad's Corollary 7.2:
every elliptic curve over a field generated by finitely many elements over Q
has a finitely generated Weierstrass point group. -/
def MordellWeilLangNeronTheorem : Prop :=
  ∀ (F : Type u) [Field F] [Algebra ℚ F] [DecidableEq F],
    (⊤ : IntermediateField ℚ F).FG →
    ∀ W : WeierstrassCurve F, W.IsElliptic → AddGroup.FG W.toAffine.Point

/-- An application with an explicit finite set of field generators. -/
theorem points_finitely_generated_of_field_generators
    (hMWLN : MordellWeilLangNeronTheorem.{u})
    {F : Type u} [Field F] [Algebra ℚ F] [DecidableEq F]
    (s : Finset F) (hs : IntermediateField.adjoin ℚ (s : Set F) = ⊤)
    (W : WeierstrassCurve F) (hW : W.IsElliptic) : AddGroup.FG W.toAffine.Point :=
  hMWLN F ⟨s, hs⟩ W hW

namespace FunctionField

/-- The constructed field is finitely generated over Q by m,u,v. -/
theorem field_finitely_generated : (⊤ : IntermediateField ℚ K).FG := by
  rw [← field_adjoin_coordinates_eq_top]
  exact IntermediateField.fg_adjoin_of_finite (by simp)

/-- The generic point group is finitely generated, assuming only the
published Mordell–Weil–Lang–Néron corollary. -/
theorem pointGroup_finitely_generated (hMWLN : MordellWeilLangNeronTheorem.{0}) :
    AddGroup.FG PointGroup :=
  hMWLN K field_finitely_generated (X m) genericFiberElliptic

/-- The same conclusion in the Z-module form used for finite index. -/
theorem pointGroup_moduleFinite (hMWLN : MordellWeilLangNeronTheorem.{0}) :
    Module.Finite ℤ PointGroup :=
  Module.Finite.iff_addGroup_fg.mpr (pointGroup_finitely_generated hMWLN)

end FunctionField
end Z2Z4Rank6
