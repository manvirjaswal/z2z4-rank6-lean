def q12StageFirst : List ECFullTriple := (List.finRange 4).flatMap q12FirstChunk

theorem q12FirstChunk_check (i : Fin 4) :
    (q12RawChunk i).filter (splitCoverResiduePossibleFor 16 (r2 2) (r3 2))=q12FirstChunk i := by
  fin_cases i <;> decide +kernel

theorem q12StageFirst_check :
    q12RawPool.filter (splitCoverResiduePossibleFor 16 (r2 2) (r3 2))=q12StageFirst := by
  simp only [q12RawPool,List.filter_flatMap,q12FirstChunk_check]
  rfl

