def q12RawPool : List ECFullTriple := (List.finRange 4).flatMap q12RawChunk

theorem q12Vectors_chunks : binaryVectors 6=
    (List.finRange 4).flatMap q12FreeChunk := by decide +kernel

theorem q12DecodedChunk_check (i : Fin 4) :
    (q12FreeChunk i).map (fun v => candidate q12Primes (q12KernelBasis.mulVec v))=q12RawChunk i := by
  fin_cases i <;> decide +kernel

theorem q12RawPool_decode : decodedPool q12Primes q12KernelBasis=q12RawPool := by
  rw [decodedPool,q12Vectors_chunks,List.map_flatMap]
  simp only [q12DecodedChunk_check]
  rfl

