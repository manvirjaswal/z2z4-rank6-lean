def q12FreeTail (i : Fin 4) : Fin 2 → ZMod 2 :=
  fun j => if i.val.testBit j.val then 1 else 0

def q12FreeChunk (i : Fin 4) : List (Fin 6 → ZMod 2) :=
  (binaryVectors 4).map (fun v => Fin.append v (q12FreeTail i))

