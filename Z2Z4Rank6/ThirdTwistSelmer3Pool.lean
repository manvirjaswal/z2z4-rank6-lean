module

public import Z2Z4Rank6.ThirdTwistSelmer3Data
public import Z2Z4Rank6.TwistSelmerDataSieve

@[expose] public section

/-! Exact certificate for the third-twist paragraph after Proposition 7.2,
Jaswal, DOI 10.5281/zenodo.23437117. -/
namespace Z2Z4Rank6.ThirdTwist.Selmer3
open Z2Z4Rank6.TwistSelmer
open scoped BigOperators
set_option maxRecDepth 100000
set_option maxHeartbeats 10000000
def freeTail (i : Fin 2) : Fin 1 → ZMod 2 :=
  fun j => if i.val.testBit j.val then 1 else 0
def freeChunk (i : Fin 2) : List (Fin 4 → ZMod 2) :=
  (binaryVectors 3).map (fun v => Fin.append v (freeTail i))
def rawChunk : Fin 2 → List ECFullTriple
  | 0 => [(1,1,1),(-62521612993073,6305451632738134260592463857,-4925729654938424969),(6610653218,8215,20117630),(-3134836358146,19188836374735648997542495,-24484641853630),(2428935639,78181525135,3685262526184785),(-231663,2016285695965316455,-173034864961113585),(328757625729822,25690449159361,732742878),(-567317166,245439524767537,-139242055615505899640142)]
  | 1 => [(1,3134836358146,3134836358146),(-62521612993073,8045653313102818,-186344406846823176027986),(6610653218,25752680682169390,190266625055),(-3134836358146,24484641853630,-19188836374735648997542495),(2428935639,25983790,242306610),(-231663,24266866506918868496830,-942756497853648690),(328757625729822,8538273394,998062023),(-567317166,2953970359941432562,-2288796946343583)]
def rawPool : List ECFullTriple := (List.finRange 2).flatMap rawChunk
theorem vectors_chunks : binaryVectors 4=(List.finRange 2).flatMap freeChunk := by decide +kernel
theorem decodedChunk_check (i : Fin 2) :
    (freeChunk i).map (fun v => candidate primes (kernelBasis.mulVec v))=rawChunk i := by
  fin_cases i <;> decide +kernel
theorem rawPool_decode : decodedPool primes kernelBasis=rawPool := by
  rw [decodedPool,vectors_chunks,List.map_flatMap]
  simp only [decodedChunk_check]
  rfl
theorem rawPool_explicit : rawPool=[(1,1,1),(-62521612993073,6305451632738134260592463857,-4925729654938424969),(6610653218,8215,20117630),(-3134836358146,19188836374735648997542495,-24484641853630),(2428935639,78181525135,3685262526184785),(-231663,2016285695965316455,-173034864961113585),(328757625729822,25690449159361,732742878),(-567317166,245439524767537,-139242055615505899640142),(1,3134836358146,3134836358146),(-62521612993073,8045653313102818,-186344406846823176027986),(6610653218,25752680682169390,190266625055),(-3134836358146,24484641853630,-19188836374735648997542495),(2428935639,25983790,242306610),(-231663,24266866506918868496830,-942756497853648690),(328757625729822,8538273394,998062023),(-567317166,2953970359941432562,-2288796946343583)] := rfl

end Z2Z4Rank6.ThirdTwist.Selmer3
