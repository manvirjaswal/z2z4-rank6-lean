def q1RawPool : List ECFullTriple := (List.finRange 8).flatMap q1RawChunk

theorem q1Vectors_chunks : binaryVectors 7=
    (List.finRange 8).flatMap q1FreeChunk := by decide +kernel

theorem q1DecodedChunk_check (i : Fin 8) :
    (q1FreeChunk i).map (fun v => candidate q1Primes (q1KernelBasis.mulVec v))=q1RawChunk i := by
  fin_cases i <;> decide +kernel

theorem q1RawPool_decode : decodedPool q1Primes q1KernelBasis=q1RawPool := by
  rw [decodedPool,q1Vectors_chunks,List.map_flatMap]
  simp only [q1DecodedChunk_check]
  rfl

