def hFreeTail (i : Fin 8) : Fin 3 → ZMod 2 :=
  fun j => if i.val.testBit j.val then 1 else 0

def hFreeChunk (i : Fin 8) : List (Fin 7 → ZMod 2) :=
  (binaryVectors 4).map (fun v => Fin.append v (hFreeTail i))

