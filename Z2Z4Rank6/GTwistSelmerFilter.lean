def hRawPool : List ECFullTriple := (List.finRange 8).flatMap hRawChunk

theorem hVectors_chunks : binaryVectors 7=(List.finRange 8).flatMap hFreeChunk := by decide +kernel

theorem hDecodedChunk_check (i : Fin 8) :
    (hFreeChunk i).map (fun v => candidate hPrimes (hKernelBasis.mulVec v))=hRawChunk i := by
  fin_cases i <;> decide +kernel

theorem hRawPool_decode : decodedPool hPrimes hKernelBasis=hRawPool := by
  rw [decodedPool,hVectors_chunks,List.map_flatMap]
  simp only [hDecodedChunk_check]
  rfl

